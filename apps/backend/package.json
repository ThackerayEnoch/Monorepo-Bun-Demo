{
  "name": "@monorepo-demo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@qntx/oxfmt": "^1.1.1",
    "@qntx/oxlint": "^1.1.1",
    "@qntx/tsconfig": "^1.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "bun-types": "1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^6.0.2"
  }
}